{
  "name": "ssb-management-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @ssb/api dev",
    "dev:web": "bun --filter @ssb/web dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "db:generate": "bun --filter @ssb/db generate",
    "db:migrate": "bun --filter @ssb/db migrate",
    "docs:izin": "bun tools/permissions-doc.ts",
    "progress": "bun tools/progress.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/bun": "latest"
  }
}
