{
  "name": "ssb-management-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun tools/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun --filter @ssb/web dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "db:generate": "bun --filter @ssb/db generate",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "db:seed": "bun tools/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "docs:izin": "bun tools/permissions-doc.ts",
    "progress": "bun tools/progress.ts",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
