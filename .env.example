# Role pemilik: hanya untuk migrasi
DATABASE_URL_OWNER=postgres://ssb_owner:ganti@localhost:5432/ssb
# Role aplikasi (tanpa BYPASSRLS): dipakai API dan test
DATABASE_URL=postgres://ssb_app:ganti@localhost:5432/ssb

# Login Google (opsional; harus diisi berpasangan). Cara menyiapkan: docs/auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email reset kata sandi lewat SMTP (opsional). Kosong = tombol Lupa kata sandi menyarankan meminta tautan ke admin.
# Contoh: SMTP_URL=smtps://user:sandi@smtp.contoh.id:465 dan MAIL_FROM="SSB App <no-reply@contoh.id>"
SMTP_URL=
MAIL_FROM=
SESSION_SECRET=
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
